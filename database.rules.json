{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      ".indexOn": ["username", "displayName"],

      /*
        Lectura a nivel de COLECCION.

        "Nueva conversacion", la creacion de grupos y el boton + de Llamadas listan
        usuarios (getAllUsers) y buscan por username (orderByChild().equalTo()).
        Firebase exige permiso de lectura EN el nodo consultado y NO hereda hacia
        arriba desde users/$uid: sin este ".read", cualquier consulta a /users
        devolvia PERMISSION_DENIED y las tres pantallas fallaban con el error
        "failed to contact database / firebase denied".

        La ESCRITURA sigue restringida a cada usuario sobre su propio nodo.
      */
      ".read": "auth != null",
      "demo_azel_assistant": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      },
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "data.exists() || newData.hasChildren(['displayName'])",
        
        "online": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },

        "lastSeen": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },

        /*
          Claves publicas del cifrado de extremo a extremo.

          Tienen que ser legibles por cualquier usuario autenticado: para
          escribirle a alguien hay que derivar el secreto ECDH contra SU clave
          publica. Publicar la clave publica no filtra nada; es exactamente para
          lo que existe. La privada nunca sale del dispositivo.

          Se declara el nodo de forma explicita aunque herede los permisos del
          padre, porque es el unico sitio del arbol donde un permiso mal puesto
          se manifiesta como "no se pudo descifrar" y no como un error de red.
        */
        "keys": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          "identityPublic": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 2048"
          }
        }
      }
    },
    
    /*
      Tokens de notificaciones push, en su PROPIO nodo raíz.

      Antes colgaban de users/$uid/fcmTokens. Al abrir la lectura de /users (para
      que funcione la lista de contactos) esa regla más estricta habría dejado de
      proteger nada: en Firebase el permiso de lectura cascadea hacia abajo y un
      hijo no puede revocar lo que concede el padre. Aquí cada usuario es el único
      que lee y escribe los suyos. Las Cloud Functions usan el Admin SDK, que no
      pasa por estas reglas.
    */
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('chats').child($chatId).child('members').child(auth.uid).exists() || root.child('groups').child($chatId).child('members').child(auth.uid).exists())",
          ".validate": "newData.val() === true"
        }
      }
    },
    
    "chats": {
      "$chatId": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || (!data.child('members').exists() && $chatId.contains(auth.uid)))",
        /*
          Chats de dos: cualquiera de los dos escribe en todo el nodo (salvo si esta
          bloqueado). Crearlo solo se puede si tu uid esta en el id: antes cualquiera podia
          crear el chat "uidA_uidB" de otros dos, meterse como miembro y leer lo que
          escribieran despues.

          Grupos ("group_..."): el nodo entero solo se escribe al crearlo (siendo miembro y
          administrador) o para borrarlo (siendo administrador). Lo demas va campo a campo:
          antes cualquier miembro podia hacerse administrador, echar a otros, cambiar el
          nombre o borrar el grupo para todos.

          El bloqueo se comprueba en el padre: un permiso concedido arriba no se puede
          retirar en un hijo.
        */
        ".write": "auth != null && (($chatId.beginsWith('group_') && ((!data.exists() && newData.child('members').child(auth.uid).val() === true && newData.child('admins').child(auth.uid).val() === true) || (data.exists() && !newData.exists() && (data.child('admins').child(auth.uid).val() === true || (!data.child('admins').exists() && data.child('createdBy').val() === auth.uid))))) || (!$chatId.beginsWith('group_') && ((!data.exists() && $chatId.contains(auth.uid)) || (!data.child('members').exists() && $chatId.contains(auth.uid)) || (data.child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()))))",

        /* Entrar con enlace (uno mismo, con el codigo vigente), lo hace un administrador, o salirse. */
        "members": {
          "$memberId": {
            ".write": "auth != null && $chatId.beginsWith('group_') && ((auth.uid === $memberId && !data.exists() && root.child('chats').child($chatId).child('inviteCode').exists() && newData.parent().parent().child('joinCodes').child($memberId).val() === root.child('chats').child($chatId).child('inviteCode').val() && !root.child('chats').child($chatId).child('removed').child($memberId).exists()) || (auth.uid === $memberId && !newData.exists()) || (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid)))",
            ".validate": "newData.val() === true"
          }
        },
        "joinCodes": {
          "$memberId": {
            ".write": "auth != null && ((auth.uid === $memberId && newData.val() === root.child('chats').child($chatId).child('inviteCode').val()) || (!newData.exists() && (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid))))"
          }
        },
        /* Administradores: los nombra un administrador; cada uno puede dejar de serlo. */
        "admins": {
          "$adminId": {
            ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && ((root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid)) || (auth.uid === $adminId && !newData.exists()))",
            ".validate": "newData.val() === true"
          }
        },
        "removed": {
          "$memberId": { ".write": "auth != null && $chatId.beginsWith('group_') && (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid))" }
        },
        /* Foto, nombre y descripcion: administradores, o todos si el grupo lo permite. */
        "groupName": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && ((root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid)) || root.child('chats').child($chatId).child('settings').child('editInfo').val() === 'all')",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "groupPhoto": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && ((root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid)) || root.child('chats').child($chatId).child('settings').child('editInfo').val() === 'all')",
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "groupDescription": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && ((root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid)) || root.child('chats').child($chatId).child('settings').child('editInfo').val() === 'all')",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "inviteCode": { ".write": "auth != null && $chatId.beginsWith('group_') && (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid))" },

        /*
          Ajustes del grupo. "onlyAdmins" (solo los administradores escriben) y "editInfo"
          (quien cambia foto, nombre y descripcion) los decide un administrador; el fondo
          del chat lo puede cambiar cualquier miembro.
        */
        "settings": {
          ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid))",
          "onlyAdmins": { ".validate": "newData.isBoolean()" },
          "editInfo": { ".validate": "newData.val() === 'all' || newData.val() === 'admins'" },
          "background": { ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()" }
        },

        /*
          Temporizador de mensajes temporales de la conversacion, en segundos.
          0 = desactivado. Es compartido: lo que elige un participante vale para todos.
        */
        "disappearingSeconds": {
          ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 604800"
        },

        /* Lo que cualquier miembro del grupo actualiza al escribir, leer o votar. */
        "lastMessage": { ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()" },
        "lastMessageTime": { ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()" },
        "lastMessagePayload": { ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()" },
        "pinnedMessageId": { ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()" },
        "lastMessageSenderId": {
          ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()",
          ".validate": "!$chatId.beginsWith('group_') || newData.val() === auth.uid || newData.val() === ''"
        },
        "typing": {
          "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists()" }
        },
        "unreadCount": {
          "$uid": { ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()" }
        },
        "pollVotes": {
          "$messageId": {
            "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()" }
          }
        },

        "messages": {
          ".indexOn": ["timestamp"],
          /* Vaciar el chat de un grupo: solo un administrador. */
          ".write": "auth != null && $chatId.beginsWith('group_') && !newData.exists() && (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid))",
          "$messageId": {
            ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
            /*
              Grupos: un mensaje nuevo lleva tu uid como remitente (antes se podia escribir
              en nombre de otro) y, si el grupo es "solo administradores", tienes que serlo.
              Reacciones, leidos y borrados sobre mensajes existentes: cualquier miembro.
            */
            ".write": "auth != null && $chatId.beginsWith('group_') && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists() && (data.exists() || (newData.child('senderId').val() === auth.uid && (root.child('chats').child($chatId).child('settings').child('onlyAdmins').val() !== true || (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (!root.child('chats').child($chatId).child('admins').exists() && root.child('chats').child($chatId).child('createdBy').val() === auth.uid)))))"
          }
        }
      }
    },

    /*
      Suscripcion Premium. SOLO la escribe el servidor (Cloud Functions, con el Admin
      SDK) tras confirmar el pago con la pasarela: si un cliente pudiera escribir aqui,
      cualquiera se regalaria Premium. Se puede leer para mostrar la insignia VIP.
    */
    "premium": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    /* Recibos de pago de cada usuario: solo el dueno los ve, solo el servidor escribe. */
    "payments": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    /*
      Indice de mensajes temporales por fecha de borrado. Lo mantienen las Cloud
      Functions con el Admin SDK, que ignora estas reglas; ningun cliente lo lee
      ni lo escribe (ni siquiera deja ver que chats tienen mensajes temporales).
    */
    "expiringMessages": {
      ".indexOn": ["at"],
      ".read": false,
      ".write": false
    },

    /*
      Bloqueos por conversacion.

      chatBlocks/$chatId/$uidBloqueado = true  →  ese uid NO puede escribir en el chat.

      Se indexa por chat y no por usuario a proposito: la regla de escritura de
      mensajes ya conoce el $chatId, asi que puede resolver el bloqueo con una sola
      lectura. Con un indice global (blockedUsers/$uid/$otro) la regla tendria que
      deducir quien es el otro miembro a partir del chatId, cosa que el lenguaje de
      reglas no puede hacer de forma fiable.

      Quien bloquea puede deshacerlo; el bloqueado NO puede desbloquearse solo,
      porque la condicion $uidBloqueado !== auth.uid le impide escribir en su propia
      casilla (y borrar es escribir null).
    */
    "chatBlocks": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        "$blockedUid": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && $blockedUid !== auth.uid",
          ".validate": "newData.val() === true || !newData.exists()"
        }
      }
    },
    
    "stories": {
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null",
        "$storyId": {
          ".write": "auth != null && auth.uid === $userId",
          ".validate": "newData.hasChildren(['storyId', 'userId', 'mediaUrl', 'mediaType', 'timestamp'])"
        }
      }
    },
    
    "stories_views": {
      "$storyId": {
        ".read": "auth != null",
        "$viewerId": {
          ".write": "auth != null && auth.uid === $viewerId"
        }
      }
    },

    "stories_reactions": {
      "$ownerId": {
        "$storyId": {
          ".read": "auth != null",
          "$reactorId": {
            ".write": "auth != null && auth.uid === $reactorId",
            ".validate": "newData.hasChildren(['emoji', 'timestamp'])"
          }
        }
      }
    },
    
    "userCalls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('calls').child($callId).child('callerId').val() === auth.uid || root.child('calls').child($callId).child('receiverId').val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    /*
      Configuracion remota de solo lectura (servidores STUN/TURN de las llamadas
      en config/webrtc/iceServers). La escribe el administrador desde la consola.
    */
    "config": {
      ".read": "auth != null",
      ".write": false
    },

    "calls": {
      ".indexOn": ["callerId", "receiverId"],
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('receiverId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('callerId').val() === auth.uid) || data.child('callerId').val() === auth.uid || data.child('receiverId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['callerId', 'receiverId', 'callType'])"
      }
    },
    
    "friendRequests": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        "$requestId": {
          ".write": "auth != null && (!data.exists() || auth.uid === $userId || data.child('from').val() === auth.uid)"
        }
      }
    },

    "chat_settings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "typing": {
      "$chatId": {
        "$userId": {
          ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('groups').child($groupId).child('members').child(auth.uid).exists())"
      }
    },

    "group_settings": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('groups').child($groupId).child('members').child(auth.uid).exists())"
      }
    },

    "reports": {
      "$reportId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
        ".validate": "newData.hasChildren(['by', 'target', 'reason'])"
      }
    },

    "codeFiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["timestamp"]
      }
    },

    "terminal": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /*
      Claves de grupo, cifradas por separado para cada miembro: el servidor no puede leerlas.
    */
    "groupInvites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && root.child('chats').child(data.child('chatId').val()).child('members').child(auth.uid).exists()) || (!data.exists() && newData.exists() && root.child('chats').child(newData.child('chatId').val()).child('members').child(auth.uid).exists()))"
      }
    },

    "groupKeys": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()"
      }
    },

    /*
      Chats secretos. El servidor solo guarda texto cifrado hasta entregarlo.
    */
    "secretChats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).exists()) || data.child('members').child(auth.uid).exists())",
        "messages": { ".indexOn": ["n"] }
      }
    },
    "userSecretChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('secretChats').child($chatId).child('members').child(auth.uid).exists())"
        }
      }
    },

    /*
      Canales: públicos para leer, solo su dueño publica. Los seguidores los cuenta el servidor.
    */
    "channels": {
      ".read": "auth != null",
      ".indexOn": ["subscribers"],
      "$channelId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)",
        /*
          El contador sube o baja de uno en uno y solo en la misma escritura en la que el
          usuario se apunta o se borra de channelSubscribers. Antes no se podia cambiar y
          todos los canales se quedaban en 1 seguidor.
        */
        "subscribers": {
          ".write": "auth != null && data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() || (newData.val() === data.val() + 1 && !root.child('channelSubscribers').child($channelId).child(auth.uid).exists() && newData.parent().parent().parent().child('channelSubscribers').child($channelId).child(auth.uid).val() === true) || (newData.val() === data.val() - 1 && root.child('channelSubscribers').child($channelId).child(auth.uid).exists() && !newData.parent().parent().parent().child('channelSubscribers').child($channelId).child(auth.uid).exists()))"
        }
      }
    },
    "channelPosts": {
      "$channelId": {
        ".read": "auth != null",
        ".indexOn": ["at"],
        ".write": "auth != null && root.child('channels').child($channelId).child('ownerId').val() === auth.uid",
        /* Reacciones y vistas: cada persona solo escribe la suya, y solo en publicaciones que existen. */
        "$postId": {
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('channelPosts').child($channelId).child($postId).child('at').exists()",
              ".validate": "newData.isString() && newData.val().length <= 16"
            }
          },
          "views": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('channelPosts').child($channelId).child($postId).child('at').exists()",
              ".validate": "newData.val() === true"
            }
          }
        }
      }
    },
    "channelHandles": {
      ".read": "auth != null",
      "$handle": {
        ".write": "auth != null && ((!data.exists() && newData.isString() && $handle.length >= 3) || (data.exists() && !newData.exists() && root.child('channels').child(data.val()).child('ownerId').val() === auth.uid))"
      }
    },
    "channelSubscribers": {
      "$channelId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "userChannels": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /* Paquetes de stickers propios, y los publicados con un código para compartirlos. */
    "userStickerPacks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicStickerPacks": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid)"
      }
    },

    /* Notas y mensajes guardados: cifrados por el propio usuario. */
    "savedMessages": {
      "$uid": {
        ".indexOn": ["at"],
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "aiChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "agentRuns": {
          ".indexOn": ["startedAt"]
        },
        "$chatId": {
          "messages": {
            ".indexOn": ["timestamp"]
          }
        }
      }
    }
  }
}
