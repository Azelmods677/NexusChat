{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      ".indexOn": ["username", "displayName"],

      /*
        Lectura a nivel de COLECCION.

        "Nueva conversacion", la creacion de grupos y el boton + de Llamadas listan
        usuarios (getAllUsers) y buscan por username (orderByChild().equalTo()).
        Firebase exige permiso de lectura EN el nodo consultado y NO hereda hacia
        arriba desde users/$uid: sin este ".read", cualquier consulta a /users
        devolvia PERMISSION_DENIED y las tres pantallas fallaban con el error
        "failed to contact database / firebase denied".

        La ESCRITURA sigue restringida a cada usuario sobre su propio nodo.
      */
      ".read": "auth != null",
      "demo_azel_assistant": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      },
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'email'])",
        
        "online": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },

        "lastSeen": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },

        /*
          Claves publicas del cifrado de extremo a extremo.

          Tienen que ser legibles por cualquier usuario autenticado: para
          escribirle a alguien hay que derivar el secreto ECDH contra SU clave
          publica. Publicar la clave publica no filtra nada; es exactamente para
          lo que existe. La privada nunca sale del dispositivo.

          Se declara el nodo de forma explicita aunque herede los permisos del
          padre, porque es el unico sitio del arbol donde un permiso mal puesto
          se manifiesta como "no se pudo descifrar" y no como un error de red.
        */
        "keys": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          "identityPublic": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 2048"
          }
        }
      }
    },
    
    /*
      Tokens de notificaciones push, en su PROPIO nodo raíz.

      Antes colgaban de users/$uid/fcmTokens. Al abrir la lectura de /users (para
      que funcione la lista de contactos) esa regla más estricta habría dejado de
      proteger nada: en Firebase el permiso de lectura cascadea hacia abajo y un
      hijo no puede revocar lo que concede el padre. Aquí cada usuario es el único
      que lee y escribe los suyos. Las Cloud Functions usan el Admin SDK, que no
      pasa por estas reglas.
    */
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('chats').child($chatId).child('members').child(auth.uid).exists() || root.child('groups').child($chatId).child('members').child(auth.uid).exists())",
          ".validate": "newData.val() === true"
        }
      }
    },
    
    "chats": {
      "$chatId": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists())",
        /*
          El bloqueo se comprueba AQUI y no en messages/$messageId: en Firebase un
          permiso concedido por el padre no se puede retirar en un hijo, asi que con
          la comprobacion solo en el mensaje un usuario bloqueado seguia pudiendo
          escribir.
        */
        ".write": "auth != null && (!data.exists() || (data.child('members').child(auth.uid).exists() && !root.child('chatBlocks').child($chatId).child(auth.uid).exists()))",

        /*
          Entrar con un enlace: un no miembro solo puede añadirse a si mismo y solo si manda,
          en la misma escritura, el codigo vigente del grupo. Quien fue expulsado no vuelve
          por el enlace; tiene que anadirlo un administrador.
        */
        "members": {
          "$memberId": {
            ".write": "auth != null && auth.uid === $memberId && !data.exists() && root.child('chats').child($chatId).child('inviteCode').exists() && newData.parent().parent().child('joinCodes').child($memberId).val() === root.child('chats').child($chatId).child('inviteCode').val() && !root.child('chats').child($chatId).child('removed').child($memberId).exists()",
            ".validate": "newData.val() === true"
          }
        },
        "joinCodes": {
          "$memberId": {
            ".write": "auth != null && auth.uid === $memberId && newData.val() === root.child('chats').child($chatId).child('inviteCode').val()"
          }
        },

        /*
          Temporizador de mensajes temporales de la conversacion, en segundos.
          0 = desactivado. Es compartido: lo que elige un participante vale para
          los dos, y queda aviso en el chat de quien lo cambio.
        */
        "disappearingSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 604800"
        },

        "messages": {
          ".indexOn": ["timestamp"],
          "$messageId": {
            ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },

    /*
      Suscripcion Premium. SOLO la escribe el servidor (Cloud Functions, con el Admin
      SDK) tras confirmar el pago con la pasarela: si un cliente pudiera escribir aqui,
      cualquiera se regalaria Premium. Se puede leer para mostrar la insignia VIP.
    */
    "premium": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    /* Recibos de pago de cada usuario: solo el dueno los ve, solo el servidor escribe. */
    "payments": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    /*
      Indice de mensajes temporales por fecha de borrado. Lo mantienen las Cloud
      Functions con el Admin SDK, que ignora estas reglas; ningun cliente lo lee
      ni lo escribe (ni siquiera deja ver que chats tienen mensajes temporales).
    */
    "expiringMessages": {
      ".indexOn": ["at"],
      ".read": false,
      ".write": false
    },

    /*
      Bloqueos por conversacion.

      chatBlocks/$chatId/$uidBloqueado = true  →  ese uid NO puede escribir en el chat.

      Se indexa por chat y no por usuario a proposito: la regla de escritura de
      mensajes ya conoce el $chatId, asi que puede resolver el bloqueo con una sola
      lectura. Con un indice global (blockedUsers/$uid/$otro) la regla tendria que
      deducir quien es el otro miembro a partir del chatId, cosa que el lenguaje de
      reglas no puede hacer de forma fiable.

      Quien bloquea puede deshacerlo; el bloqueado NO puede desbloquearse solo,
      porque la condicion $uidBloqueado !== auth.uid le impide escribir en su propia
      casilla (y borrar es escribir null).
    */
    "chatBlocks": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        "$blockedUid": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && $blockedUid !== auth.uid",
          ".validate": "newData.val() === true || !newData.exists()"
        }
      }
    },
    
    "stories": {
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null",
        "$storyId": {
          ".write": "auth != null && auth.uid === $userId",
          ".validate": "newData.hasChildren(['storyId', 'userId', 'mediaUrl', 'mediaType', 'timestamp'])"
        }
      }
    },
    
    "stories_views": {
      "$storyId": {
        ".read": "auth != null",
        "$viewerId": {
          ".write": "auth != null && auth.uid === $viewerId"
        }
      }
    },

    "stories_reactions": {
      "$ownerId": {
        "$storyId": {
          ".read": "auth != null",
          "$reactorId": {
            ".write": "auth != null && auth.uid === $reactorId",
            ".validate": "newData.hasChildren(['emoji', 'timestamp'])"
          }
        }
      }
    },
    
    "userCalls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('calls').child($callId).child('callerId').val() === auth.uid || root.child('calls').child($callId).child('receiverId').val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    /*
      Configuracion remota de solo lectura (servidores STUN/TURN de las llamadas
      en config/webrtc/iceServers). La escribe el administrador desde la consola.
    */
    "config": {
      ".read": "auth != null",
      ".write": false
    },

    "calls": {
      ".indexOn": ["callerId", "receiverId"],
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('receiverId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('callerId').val() === auth.uid) || data.child('callerId').val() === auth.uid || data.child('receiverId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['callerId', 'receiverId', 'callType'])"
      }
    },
    
    "friendRequests": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        "$requestId": {
          ".write": "auth != null && (!data.exists() || auth.uid === $userId || data.child('from').val() === auth.uid)"
        }
      }
    },

    "chat_settings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "typing": {
      "$chatId": {
        "$userId": {
          ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('groups').child($groupId).child('members').child(auth.uid).exists())"
      }
    },

    "group_settings": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('groups').child($groupId).child('members').child(auth.uid).exists())"
      }
    },

    "codeFiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "terminal": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /*
      Claves de grupo, cifradas por separado para cada miembro: el servidor no puede leerlas.
    */
    "groupInvites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && root.child('chats').child(data.child('chatId').val()).child('members').child(auth.uid).exists()) || (!data.exists() && newData.exists() && root.child('chats').child(newData.child('chatId').val()).child('members').child(auth.uid).exists()))"
      }
    },

    "groupKeys": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()"
      }
    },

    /*
      Chats secretos. El servidor solo guarda texto cifrado hasta entregarlo.
    */
    "secretChats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).exists()) || data.child('members').child(auth.uid).exists())",
        "messages": { ".indexOn": ["n"] }
      }
    },
    "userSecretChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('secretChats').child($chatId).child('members').child(auth.uid).exists())"
        }
      }
    },

    /*
      Canales: públicos para leer, solo su dueño publica. Los seguidores los cuenta el servidor.
    */
    "channels": {
      ".read": "auth != null",
      "$channelId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)",
        "subscribers": {
          ".validate": "!data.exists() ? newData.val() === 1 : newData.val() === data.val()"
        }
      }
    },
    "channelPosts": {
      "$channelId": {
        ".read": "auth != null",
        ".indexOn": ["at"],
        ".write": "auth != null && root.child('channels').child($channelId).child('ownerId').val() === auth.uid"
      }
    },
    "channelHandles": {
      ".read": "auth != null",
      "$handle": {
        ".write": "auth != null && !data.exists() && newData.isString() && $handle.length >= 3"
      }
    },
    "channelSubscribers": {
      "$channelId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "userChannels": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /* Paquetes de stickers propios, y los publicados con un código para compartirlos. */
    "userStickerPacks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicStickerPacks": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid)"
      }
    },

    /* Notas y mensajes guardados: cifrados por el propio usuario. */
    "savedMessages": {
      "$uid": {
        ".indexOn": ["at"],
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "aiChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
