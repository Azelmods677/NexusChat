rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de Firebase Storage para NexusChat
//
// Se despliegan por comando, junto con las de la base de datos:
//   npx firebase-tools deploy --only database,storage
//
// Por qué cada carpeta separa "subir" de "borrar": al borrar un archivo no hay
// archivo nuevo, así que `request.resource` es null y `request.resource.size` da
// error. Con un único `allow write` que comprueba el tamaño, TODOS los borrados se
// rechazaban: historias, fotos de chat y fotos de perfil se quedaban para siempre.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function underMb(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function typeIs(pattern) {
      return request.resource.contentType.matches(pattern);
    }

    // Foto o video de perfil, portada y galería del perfil.
    match /user_photos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && underMb(100) && typeIs('(image|video)/.*');
      allow delete: if isOwner(userId);
    }

    // Historias: imagen, video o música. Solo el dueño en su carpeta.
    match /stories/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && underMb(100) && typeIs('(image|video|audio)/.*');
      allow delete: if isOwner(userId);
    }

    // Archivos de chats. En un chat de dos el id es "uidA_uidB": solo ellos dos leen,
    // suben o borran. Los grupos ("group_...") guardan los miembros en la base de datos,
    // que Storage no puede consultar; ahí se exige sesión y nadie puede borrar.
    function inDirectChat(chatId) {
      return signedIn() && !chatId.matches('group_.*') && request.auth.uid in chatId.split('_');
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read: if inDirectChat(chatId) || (signedIn() && chatId.matches('group_.*'));
      allow create, update: if (inDirectChat(chatId) || (signedIn() && chatId.matches('group_.*'))) && underMb(100);
      allow delete: if inDirectChat(chatId);
    }

    // Fondo de pantalla personal.
    match /user_backgrounds/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && underMb(100) && typeIs('(image|video)/.*');
      allow delete: if isOwner(userId);
    }

    // Copias de seguridad cifradas: privadas, solo las ve su dueño.
    match /backups/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && underMb(500);
    }

    // Todo lo demás queda bloqueado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
