# Copia este archivo a `keystore.properties` y rellénalo con tus datos reales.
# `keystore.properties` está en .gitignore: NUNCA lo subas al repositorio.
#
# Para crear el keystore (una sola vez, y guárdalo con tu vida: si lo pierdes
# no puedes volver a actualizar la app en Google Play):
#
#   keytool -genkey -v -keystore nexuschat-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias nexuschat
#
# Ruta relativa a la raíz del proyecto, o absoluta.
storeFile=nexuschat-release.jks
storePassword=CAMBIA_ESTO
keyAlias=nexuschat
keyPassword=CAMBIA_ESTO
