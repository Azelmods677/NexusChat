<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        base-config = true (cleartext permitido por defecto).

        MOTIVO: el navegador Tor integrado carga servicios .onion, que se sirven por
        HTTP en claro (no llevan certificado TLS público). La network security config
        NO admite comodines de TLD (no existe forma de escribir "*.onion"), así que la
        ÚNICA manera de que el WebView cargue cualquier .onion es permitir cleartext a
        nivel base. Con base-config = false, cargar un .onion fallaba con
        net::ERR_CLEARTEXT_NOT_PERMITTED (la pantalla de "Error de conexión" en rojo).

        Esto NO abre la app entera a texto plano de forma insegura: el tráfico real
        (Firebase, Gemini/OpenAI/OpenRouter, Storage) usa HTTPS igualmente, y los hosts
        comerciales de IA de abajo siguen FORZADOS a HTTPS con su propio domain-config.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.ollama.cloud</domain>
        <domain includeSubdomains="true">ollama.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.opencode.ai</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>

    <!--
        Servidores de IA locales (Ollama, LM Studio, llama.cpp, vLLM) hablan HTTP en
        claro. La base-config lo prohíbe para todo, y esa prohibición gana sobre el
        android:usesCleartextTraffic="true" del manifest, así que sin esta excepción
        cualquier modelo local falla con CleartextNotPermitted.

        Se permite SOLO loopback y el host del emulador: no se abre la red entera.
        - 127.0.0.1 / localhost: el propio dispositivo, o un PC redirigido con
          `adb reverse tcp:11434 tcp:11434` (la forma recomendada en móvil físico).
        - 10.0.2.2: el equipo anfitrión visto desde el emulador de Android.

        Para apuntar a una IP de la red local (p. ej. 192.168.1.50) hay que añadirla
        aquí a mano: la network security config no acepta rangos CIDR.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
